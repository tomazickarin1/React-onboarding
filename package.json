{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && eslint . && vitest run --project=unit",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,json,css,scss,md}\"",
    "format:write": "prettier --write \"src/**/*.{js,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "typegen": "typed-scss-modules src --watch --exportType default --nameFormat none"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.2.18",
    "jsdom": "^27.0.1",
    "msw": "^2.13.3",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "storybook": "^10.2.17",
    "terser": "^5.46.0",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.17.0",
    "zod": "^4.4.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
